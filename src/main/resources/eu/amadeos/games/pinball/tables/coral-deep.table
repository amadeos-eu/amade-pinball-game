# Coral Deep: a wreck on a reef. Medium: five flippers, two of them in the Wreck Hold, a Kraken that
# swallows balls, a pearl on a captive ball, a whirlpool that grabs the ball and flings it.
name Coral_Deep
level 2
art reef
palette 0c4a64 061a2c a8e0e8 ffd040 f4fff8 3ae0c8 ff7a5a ffd040

# left orbit; the gate only lets the ball go up
wall 36 246 22 228 22 146
gate 2 136 21 144 0 -1
switch orbitL 11 170 r=5
# right orbit with a spinner
wall 182 246 196 228 196 140
gate 215 128 197 136 0 -1
spinner spinR 206 186 0
switch orbitR 206 156 r=5

# the Kraken, upper left: an arch over its mouth, the lock hole inside
wall 30 84 32 64 44 56 60 56 72 64 74 84
saucer kraken 52 80 p6 out=90 kick=380
toy kraken 52 78

# the Wreck Hold: a raised floor, upper right, with its own flippers, targets and bumper
floor 1 128 22 72 76 10 x6a4a2a x2a1a10
wall@1 128 98 128 22 200 22 200 98
wall@1 128 78 139 86
wall@1 200 78 189 86
flipper@1 holdL left 144 88 12 25
flipper@1 holdR right 184 88 12 25
standup@1 hold1 146 32 0 p7
standup@1 hold2 164 32 0 p7
standup@1 hold3 182 32 0 p7
bumper@1 holdpop 164 56 7 xffd040 x3a2a10
hole@1 holddrain 164 98 6 exit=holdexit
track holdexit exit=0 164 99 10 164 110 6 158 130 0
label@1 WRECK_HOLD 164 96 p7 3.8

# jellyfish bumpers
bumper pop1 70 140 10 xff7aa8 xfff0f8
bumper pop2 96 126 10 x7ae8ff xf0ffff
bumper pop3 90 156 10 xc89aff xf8f0ff
bumper pop4 46 172 7 xffa040 xfff4e0

# the pearl: a captive ball in the centre lane that knocks the pearl target behind it
wall 116 128 116 176
wall 132 128 132 176
standup pearl 124 123 0 p7
captive pearl-ball 124 140 117 125 131 150
saucer chest 124 190 p7 out=80 kick=360

# the whirlpool: a magnet under the floor
magnet whirl 104 214 16 pull=70
switch whirlpool 104 214 r=5
label WHIRLPOOL 104 234 x7ae8ff 3.6

# the upper left flipper, the treasure standups on the right, the anchor chain drops
flipper upL left 27 212 22 26
standup treasure1 186 186 90 p7
standup treasure2 186 198 90 p7
standup treasure3 186 210 90 p7
drop chain1 166 200 45 p7
drop chain2 172 207 45 p7
drop chain3 178 214 45 p7
band 142 150 164 164

# the Sub Tube from the left up into the Wreck Hold, the Anchor ramp with its long wire back to the left
tube subtube p5 11 exit=1 path 60 198 C 50 150 40 120 70 108 C 100 96 112 70 134 60
ramp anchor p6 11 path 156 182 C 160 140 170 120 206 112 wire C 214 60 120 110 60 106 C 14 110 12 160 14 230 L 26 300

plastic p5 p7 12 10 22 200 22 150
plasticoval p7 p6 13 104 112 34 14

fan orbitL 36 290 -20
fan subtube 60 262 -14
fan chest 124 246 0
fan anchor 152 262 14
fan orbitR 178 290 24
modering 90 262 14
round extra 70 300 3 x4ad87a
label EXTRA 70 309 x80a8b0 3.2
round jackpot 140 300 3 p6
label JACKPOT 140 309 x80a8b0 3.2
round lock 52 100 3 p6
label KRAKEN_LOCK 52 128 p6 3.8
label SUB_TUBE 60 194 xffffff 3.6
label ANCHOR 156 178 xffffff 3.6

rules start=chest lock=kraken lock-light=subtube,anchor lock-needs=2 jackpot=subtube,anchor,orbitL,orbitR super=kraken combos=subtube,anchor,orbitL,orbitR extra=chest skill=treasure* bank=chain standups=treasure,hold magnet=whirl
mode Kraken shots=kraken count=2 time=45 value=75000
mode Sub_Tube shots=subtube count=3 time=45 value=60000
mode Anchor shots=anchor count=3 time=40 value=60000
mode Pearl_Diver shots=pearl count=3 time=40 value=50000
mode Jellyfish shots=pop* count=20 time=30 value=6000
mode Treasure shots=treasure* count=6 time=35 value=30000
mode Whirlpool shots=whirlpool count=3 time=40 value=50000
mode Wreck_Hold shots=hold* count=6 time=45 value=40000
wizard Abyss shots=subtube,anchor,orbitL,orbitR,kraken,chest count=12 time=60 value=300000 balls=4
