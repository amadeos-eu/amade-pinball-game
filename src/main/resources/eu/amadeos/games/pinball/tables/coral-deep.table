# Coral Deep: a wreck on a reef. Medium: five flippers, two of them in the Wreck Hold, a Kraken behind
# its anchor chain that swallows balls, a pearl on a captive ball, a whirlpool that grabs the ball.
# Every shot lies on a line from a main flipper: the orbits at 30 degrees across, the Sub Tube and the
# Kraken from the right flipper, the chest and the Anchor ramp from the left one, the pearl straight up.
name Coral_Deep
level 2
art reef
palette 0c4a64 061a2c a8e0e8 ffd040 f4fff8 3ae0c8 ff7a5a ffd040

# left orbit: a lane up the left side from y 150; the gate only lets the ball go up
wall 24 152 24 138
gate 2 126 23 134 0 -1
switch orbitL 12 144 r=5
# right orbit with a spinner at its mouth
wall 192 152 192 142
gate 215 128 193 136 0 -1
spinner spinR 204 168 0
switch orbitR 204 140 r=5

# the Kraken, upper left: an arch over its mouth, the lock hole inside, the anchor chain's drops across it
wall 30 92 32 64 44 58 52 52 60 58 72 64 74 92
saucer kraken 52 80 p6 out=90 kick=380
toy kraken 52 78
drop chain1 42 98 0 p7
drop chain2 52 98 0 p7
drop chain3 62 98 0 p7

# the Wreck Hold: a raised floor, upper right, with its own flippers, targets and bumper
floor 1 128 22 72 76 10 x6a4a2a x2a1a10
wall@1 128 98 128 22 200 22 200 98
wall@1 128 78 139 86
wall@1 200 78 189 86
flipper@1 holdL left 144 88 12 25
flipper@1 holdR right 184 88 12 25
standup@1 hold1 146 32 0 p7
standup@1 hold2 164 32 0 p7
standup@1 hold3 182 32 0 p7
bumper@1 holdpop 164 56 7 xffd040 x3a2a10
hole@1 holddrain 164 98 6 exit=holdexit
track holdexit exit=0 164 99 10 164 110 6 158 130 0
label@1 WRECK_HOLD 164 96 p7 3.8

# jellyfish bumpers between the Kraken and the hold, where balls coming over the top fall
bumper pop1 92 40 9 xff7aa8 xfff0f8
bumper pop2 120 50 9 x7ae8ff xf0ffff
bumper pop3 98 72 9 xc89aff xf8f0ff

# the pearl: a captive ball in the centre lane that knocks the pearl target behind it
wall 96 128 96 176
wall 112 128 112 176
standup pearl 104 123 24 p7
captive pearl-ball 104 140 97 125 111 150
saucer chest 126 196 p7 out=80 kick=360

# the whirlpool: a magnet under the floor
magnet whirl 104 222 14 pull=70
switch whirlpool 104 222 r=5
label WHIRLPOOL 104 240 x7ae8ff 3.6

# the upper left flipper under the Kraken: balls coming down the left side land on it from above
wall 0 168 10 216
flipper upL left 14 222 20 30
# the treasure standups on the right wall, facing the left flipper
standup treasure1 186 204 110 p7
standup treasure2 183 216 110 p7
standup treasure3 180 228 110 p7

# the Sub Tube from the left up into the Wreck Hold, the Anchor ramp with its long wire back to the left
tube subtube p5 11 exit=1 path 70 196 C 66 150 74 120 96 104 C 112 94 124 72 136 60
ramp anchor p6 11 path 148 184 C 152 140 168 120 206 112 wire C 214 60 120 110 60 106 C 14 110 12 160 14 230 L 26 300

plastic p5 p7 12 10 24 152 24 138
plasticoval p7 p6 13 87 112 34 14

fan orbitL 68 236 -30
fan subtube 84 228 -21
fan chest 117 220 12
fan anchor 134 226 20
fan orbitR 152 236 30
modering 110 270 14
round extra 80 304 3 x4ad87a
label EXTRA 80 313 x80a8b0 3.2
round jackpot 140 304 3 p6
label JACKPOT 140 313 x80a8b0 3.2
round lock 52 108 3 p6
label KRAKEN_LOCK 52 116 p6 3.4
label SUB_TUBE 70 204 xffffff 3.6
label ANCHOR 148 192 xffffff 3.6

rules start=chest lock=kraken lock-light=subtube,anchor lock-needs=2 jackpot=subtube,anchor,orbitL,orbitR super=kraken combos=subtube,anchor,orbitL,orbitR extra=chest skill=pop1 bank=chain standups=treasure,hold magnet=whirl
mode Kraken shots=kraken count=2 time=45 value=75000
mode Sub_Tube shots=subtube count=3 time=45 value=60000
mode Anchor shots=anchor count=3 time=40 value=60000
mode Pearl_Diver shots=pearl count=3 time=40 value=50000
mode Jellyfish shots=pop* count=20 time=30 value=6000
mode Treasure shots=treasure* count=6 time=35 value=30000
mode Whirlpool shots=whirlpool count=3 time=40 value=50000
mode Wreck_Hold shots=hold* count=6 time=45 value=40000
wizard Abyss shots=subtube,anchor,orbitL,orbitR,kraken,chest count=12 time=60 value=300000 balls=4
